@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var sidebarUser = User.Identity?.Name ?? "";
    var sidebarInitials = sidebarUser.Length >= 2
        ? (sidebarUser[0].ToString() + sidebarUser[1].ToString()).ToUpper()
        : sidebarUser.Length == 1 ? sidebarUser[0].ToString().ToUpper() : "U";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userRole = User.IsInRole("Parroco") ? "Párroco" : "Secretaria";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Notaría Parroquial</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm notaria-navbar">
            <div class="container-fluid px-3">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-church fs-5"></i>
                    <span>Notaría Parroquial</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    @if (isAuth)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="user-pill">
                                <div class="avatar-sm">@sidebarInitials</div>
                                <span>@sidebarUser</span>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-box-arrow-right"></i> Salir
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    @if (isAuth)
    {
        <div class="container-fluid p-0">
            <div class="row g-0">
                <!-- Sidebar -->
                <div class="col-auto p-0">
                    <div class="sidebar">
                        <div class="sidebar-top">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Home" ? "active" : "")"
                                       asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Panel
                                    </a>
                                </li>

                                <span class="sidebar-section-label">Sacramentos</span>

                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Bautismos" ? "active" : "")"
                                       asp-controller="Bautismos" asp-action="Index">
                                        <i class="bi bi-droplet"></i> Bautismos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Matrimonios" ? "active" : "")"
                                       asp-controller="Matrimonios" asp-action="Index">
                                        <i class="bi bi-heart"></i> Matrimonios
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Confirmaciones" ? "active" : "")"
                                       asp-controller="Confirmaciones" asp-action="Index">
                                        <i class="bi bi-star"></i> Confirmaciones
                                    </a>
                                </li>

                                @if (User.IsInRole("Parroco"))
                                {
                                    <span class="sidebar-section-label">Administración</span>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentController == "Account" ? "active" : "")"
                                           asp-controller="Account" asp-action="Register">
                                            <i class="bi bi-person-plus"></i> Nuevo Usuario
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>

                        <!-- Perfil en footer del sidebar -->
                        <div class="sidebar-footer">
                            <div class="d-flex align-items-center gap-2">
                                <div class="sidebar-user-avatar">@sidebarInitials</div>
                                <div class="overflow-hidden">
                                    <div class="text-white fw-semibold small text-truncate" style="max-width:130px;">@sidebarUser</div>
                                    <div style="font-size:0.68rem; color:rgba(255,255,255,0.50);">@userRole</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contenido principal -->
                <div class="col">
                    <div class="p-4 page-enter">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="py-2 mt-auto" style="background:#4a2c6d; color:rgba(255,255,255,0.75);">
        <div class="container text-center">
            <small>&copy; 2026 — Notaría Parroquial · Sistema de Registro de Sacramentos</small>
        </div>
    </footer>

    <!-- Toast container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" id="toast-container" style="z-index:1200;">
        @if (TempData["Success"] != null)
        {
            <div class="toast toast-notaria toast-success" role="alert" data-bs-autohide="true" data-bs-delay="5000">
                <div class="d-flex align-items-center p-3">
                    <div class="me-3"><i class="bi bi-check-circle-fill fs-5 text-success"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold text-success small mb-1">Éxito</div>
                        <div class="text-secondary small">@TempData["Success"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-sm ms-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast toast-notaria toast-danger" role="alert" data-bs-autohide="true" data-bs-delay="7000">
                <div class="d-flex align-items-center p-3">
                    <div class="me-3"><i class="bi bi-x-circle-fill fs-5 text-danger"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold text-danger small mb-1">Error</div>
                        <div class="text-secondary small">@TempData["Error"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-sm ms-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="toast toast-notaria toast-warning" role="alert" data-bs-autohide="true" data-bs-delay="6000">
                <div class="d-flex align-items-center p-3">
                    <div class="me-3"><i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold text-warning small mb-1">Advertencia</div>
                        <div class="text-secondary small">@TempData["Warning"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-sm ms-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="toast toast-notaria toast-info" role="alert" data-bs-autohide="true" data-bs-delay="5000">
                <div class="d-flex align-items-center p-3">
                    <div class="me-3"><i class="bi bi-info-circle-fill fs-5" style="color:var(--primary);"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold small mb-1" style="color:var(--primary);">Información</div>
                        <div class="text-secondary small">@TempData["Info"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-sm ms-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
