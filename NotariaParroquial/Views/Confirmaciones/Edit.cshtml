@model NotariaParroquial.Models.Confirmacion
@{
    ViewData["Title"] = "Editar Confirmación";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Confirmación</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaRegistro" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="NombreConfirmado" class="form-label fw-semibold"></label>
                    <input asp-for="NombreConfirmado" class="form-control" />
                    <span asp-validation-for="NombreConfirmado" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ApellidoPaterno" class="form-label fw-semibold"></label>
                    <input asp-for="ApellidoPaterno" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ApellidoMaterno" class="form-label fw-semibold"></label>
                    <input asp-for="ApellidoMaterno" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="FechaConfirmacion" class="form-label fw-semibold"></label>
                    <input asp-for="FechaConfirmacion" class="form-control" type="date" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="NombrePadre" class="form-label fw-semibold"></label>
                    <input asp-for="NombrePadre" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="NombreMadre" class="form-label fw-semibold"></label>
                    <input asp-for="NombreMadre" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Padrino" class="form-label fw-semibold"></label>
                    <input asp-for="Padrino" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Ministro" class="form-label fw-semibold"></label>
                    <input asp-for="Ministro" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Obispo" class="form-label fw-semibold"></label>
                    <input asp-for="Obispo" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Libro" class="form-label fw-semibold"></label>
                    <input asp-for="Libro" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Folio" class="form-label fw-semibold"></label>
                    <input asp-for="Folio" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Acta" class="form-label fw-semibold"></label>
                    <input asp-for="Acta" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Observaciones" class="form-label fw-semibold"></label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
