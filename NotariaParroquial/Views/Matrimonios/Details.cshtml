@model NotariaParroquial.Models.Matrimonio
@{
    ViewData["Title"] = "Detalle de Matrimonio";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-heart"></i> Detalle de Matrimonio</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>
</div>

<div class="card">
    <div class="card-header" style="background:#f0e6ff; color:#4a2c6d;">
        <strong>@Model.NombreNovio</strong> y <strong>@Model.NombreNovia</strong>
        — @Model.FechaMatrimonio.ToString("dd/MM/yyyy")
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6 class="fw-bold text-muted">NOVIO</h6>
                <table class="table table-sm">
                    <tr><th>Nombre:</th><td>@Model.NombreNovio</td></tr>
                    <tr><th>Padre:</th><td>@(Model.PadreNovio ?? "-")</td></tr>
                    <tr><th>Madre:</th><td>@(Model.MadreNovio ?? "-")</td></tr>
                </table>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold text-muted">NOVIA</h6>
                <table class="table table-sm">
                    <tr><th>Nombre:</th><td>@Model.NombreNovia</td></tr>
                    <tr><th>Padre:</th><td>@(Model.PadreNovia ?? "-")</td></tr>
                    <tr><th>Madre:</th><td>@(Model.MadreNovia ?? "-")</td></tr>
                </table>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <table class="table table-sm">
                    <tr><th>Testigo 1:</th><td>@(Model.Testigo1 ?? "-")</td></tr>
                    <tr><th>Testigo 2:</th><td>@(Model.Testigo2 ?? "-")</td></tr>
                    <tr><th>Ministro:</th><td>@(Model.Ministro ?? "-")</td></tr>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-sm">
                    <tr><th>Libro:</th><td>@(Model.Libro ?? "-")</td></tr>
                    <tr><th>Folio:</th><td>@(Model.Folio ?? "-")</td></tr>
                    <tr><th>Acta:</th><td>@(Model.Acta ?? "-")</td></tr>
                </table>
            </div>
        </div>
        @if (Model.Observaciones != null)
        {
            <p class="mt-2"><strong>Observaciones:</strong> @Model.Observaciones</p>
        }
        <small class="text-muted">Registrado: @Model.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
    </div>
</div>
