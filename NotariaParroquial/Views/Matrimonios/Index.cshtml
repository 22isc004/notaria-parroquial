@model IEnumerable<NotariaParroquial.Models.Matrimonio>
@{
    ViewData["Title"] = "Matrimonios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-heart me-2" style="color:var(--pink);"></i>Matrimonios</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Matrimonio
    </a>
</div>

<!-- Barra de búsqueda -->
<div class="card search-bar-card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text" style="background:#fce4f4; border-color:rgba(233,30,140,0.15); border-radius:9px 0 0 9px;">
                        <i class="bi bi-search" style="color:var(--pink);"></i>
                    </span>
                    <input type="text" name="buscar" value="@ViewData["Buscar"]" class="form-control"
                           placeholder="Buscar por nombre del novio o novia..."
                           style="border-left:none; border-radius:0 9px 9px 0;" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Novio</th>
                        <th>Novia</th>
                        <th>Fecha</th>
                        <th>Ministro</th>
                        <th>Libro / Folio</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="bi bi-heart"></i>
                                    <p>No hay matrimonios registrados@(ViewData["Buscar"] != null ? " con ese criterio" : "").</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @{int n = 1;}
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted" style="font-size:0.75rem; width:36px;">@n</td>
                            <td class="fw-semibold">@item.NombreNovio</td>
                            <td class="fw-semibold">@item.NombreNovia</td>
                            <td>
                                <span class="badge" style="background:#fce4f4; color:#7c0b40; font-size:0.75rem; font-weight:600; padding:5px 10px; border-radius:8px;">
                                    @item.FechaMatrimonio.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td class="text-muted small">@(item.Ministro ?? "–")</td>
                            <td>
                                @if (item.Libro != null)
                                {
                                    <span class="badge-book">L:@item.Libro · F:@item.Folio</span>
                                }
                                else { <span class="text-muted">–</span> }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-icon btn-outline-info me-1" title="Ver detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-icon btn-outline-warning me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (User.IsInRole("Parroco"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-icon btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                        n++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<p class="text-muted mt-2 small">@Model.Count() registro(s) encontrado(s)</p>
